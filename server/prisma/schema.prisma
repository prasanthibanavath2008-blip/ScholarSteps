generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  STUDENT
  EDITOR
  ADMIN
  ADVISOR
}

enum FreshnessState {
  REVIEWED
  REVIEW_DUE
  SOURCE_CHANGED
  LINK_UNAVAILABLE
  UNVERIFIED
}

enum ApplicationStage {
  EXPLORING
  PREPARING
  READY_TO_APPLY
  SUBMITTED
  FOLLOW_UP
  AWARDED
  NOT_SELECTED
  WITHDRAWN
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  displayName     String
  role            Role             @default(STUDENT)
  status          String           @default("ACTIVE")
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions        Session[]
  tokens          OneTimeToken[]
  profile         StudentProfile?
  saved           SavedScholarship[]
  plans           PreparationPlan[]
  reminders       Reminder[]
  notifications   Notification[]
  reports         Report[]

  @@index([email])
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  csrfTokenHash String
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model OneTimeToken {
  id         String    @id @default(uuid())
  userId     String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  domicileState String?
  studyLevel    String?
  courseGroup   String?
  academicYear  String?
  preferences   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Provider {
  id              String        @id @default(uuid())
  name            String
  type            String
  officialWebsite String

  scholarships    Scholarship[]
}

model Scholarship {
  id                        String               @id @default(uuid())
  slug                      String               @unique
  providerId                String
  currentPublishedVersionId String?
  lifecycleStatus           String               @default("PUBLISHED")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  provider                  Provider             @relation(fields: [providerId], references: [id])
  versions                  ScholarshipVersion[]
  savedBy                   SavedScholarship[]
  plans                     PreparationPlan[]
  reports                   Report[]

  @@index([slug])
}

model ScholarshipVersion {
  id              String                 @id @default(uuid())
  scholarshipId   String
  versionNumber   Int
  name            String
  studyLevel      String
  benefits        Json
  deadline        Json
  reviewState     String                 @default("PUBLISHED")
  createdAt       DateTime               @default(now())

  scholarship     Scholarship            @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  rules           EligibilityRule[]
  documents       DocumentRequirement[]
  sources         SourceReference[]

  @@unique([scholarshipId, versionNumber])
}

model EligibilityRule {
  id                String             @id @default(uuid())
  versionId         String
  field             String
  operator          String
  expectedValue     String
  explanation       String
  sourceId          String?

  version           ScholarshipVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model DocumentRequirement {
  id              String             @id @default(uuid())
  versionId       String
  title           String
  description     String
  requirementType String
  condition       String?
  instructionUrl  String?
  sourceId        String?

  version         ScholarshipVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model SourceReference {
  id           String             @id @default(uuid())
  versionId    String
  url          String
  organization String
  reviewedAt   DateTime
  freshness    FreshnessState     @default(REVIEWED)
  excerpt      String
  notes        String?

  version      ScholarshipVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model SavedScholarship {
  id            String      @id @default(uuid())
  userId        String
  scholarshipId String
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
}

model PreparationPlan {
  id                     String                   @id @default(uuid())
  userId                 String
  scholarshipId          String
  versionId              Int
  cycle                  String
  stage                  ApplicationStage         @default(PREPARING)
  userNotes              String?
  sourceVersionCheckDate DateTime                 @default(now())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship            Scholarship              @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  items                  ChecklistItem[]
  history                ApplicationStatusHistory[]

  @@index([userId])
}

model ChecklistItem {
  id                  String          @id @default(uuid())
  planId              String
  sourceRequirementId String?
  title               String
  description         String
  requirementType     String
  applicability       String          @default("APPLICABLE")
  status              ChecklistStatus @default(NOT_STARTED)
  instructionLink     String?
  note                String?
  markedReadyAt       DateTime?

  plan                PreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model ApplicationStatusHistory {
  id             String           @id @default(uuid())
  planId         String
  previousStatus ApplicationStage
  newStatus      ApplicationStage
  note           String?
  changedAt      DateTime         @default(now())

  plan           PreparationPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model Reminder {
  id               String   @id @default(uuid())
  userId           String
  planId           String?
  channel          String   @default("IN_APP")
  schedule         DateTime
  status           String   @default("PENDING")
  deduplicationKey String   @unique

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Resource {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String
  category    String
  language    String   @default("en")
  reviewState String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id            String      @id @default(uuid())
  userId        String?
  scholarshipId String
  category      String
  description   String
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())

  user          User?       @relation(fields: [userId], references: [id])
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id])

  @@index([scholarshipId])
}

model AuditEvent {
  id               String   @id @default(uuid())
  actorId          String
  action           String
  entity           String
  requestId        String?
  redactedMetadata Json?
  createdAt        DateTime @default(now())

  @@index([actorId])
  @@index([entity])
}

